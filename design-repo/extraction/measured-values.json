      "specCite": {
        "cite": "CLONE_SPEC.md:748",
        "quote": "`a.cta-primary.cta-wide.quote-cta` \"Get a quote\""
      },
      "correctedTo": "Connect Now = cta-primary cta-wide; Get a quote = cta-primary quote-cta.",
      "evidence": [
        {
          "cite": "recon/dom-1440-clean.html:1",
          "quote": "class=\"cta-primary cta-wide\""
        },
        {
          "cite": "recon/dom-1440-clean.html:1",
          "quote": "class=\"cta-primary quote-cta\""
