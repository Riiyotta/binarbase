    {
      "claim": "CLONE_SPEC 11/16: the deployment auto-cycle IntersectionObserver watches the diagram.",
      "specCite": {
        "cite": "CLONE_SPEC.md:564",
        "quote": "an IntersectionObserver (threshold .35) on the diagram"
      },
      "correctedTo": "It observes the section root (ref \"root\" on section#deployment) - the clone matches the original JS.",
      "evidence": [
        {
          "cite": "recon/js/DC-ke6xp.js:1",
          "quote": "l(\"section\",{id:\"deployment\",ref_key:\"root\",ref:G"
        },
        {
          "cite": "src/components/Deployment.jsx:137",
          "quote": "IO threshold .35 on the section root"
        }
      ]
    },
    {
      "claim": "CLONE_SPEC 13: the stage pill reads \"START HERE\" for Finance and \"EXPAND\" for the other departments.",
      "specCite": {
        "cite": "CLONE_SPEC.md:679",
        "quote": "The pill is \"START HERE\" for Finance and \"EXPAND\" for the others"
      },
      "correctedTo": "Only Finance renders a stage pill (\"Start here\"); no \"Expand\" pill exists in the rendered DOM.",
      "evidence": [
