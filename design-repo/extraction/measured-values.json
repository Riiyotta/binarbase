          "cite": "recon/dom-1440-clean.html:1",
          "quote": "ct-detail-stage\">Start here"
        }
      ]
    },
    {
      "claim": "assets.manifest / CLONE_SPEC 4: the intro is three.js r186.",
      "specCite": {
        "cite": "CLONE_SPEC.md:205",
        "quote": "WebGL (three.js r186)"
      },
      "correctedTo": "True for the ORIGINAL chunk; the clone installs three 0.169.0 (r169). Both facts recorded; not a defect, a version difference.",
      "evidence": [
        {
          "cite": "package.json:14",
          "quote": "\"three\": \"^0.169.0\""
        }
      ]
    }
