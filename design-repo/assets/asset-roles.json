  "policyMeaning": {
    "may-generate-new": "A generator may create a new asset/value for this role.",
    "must-reuse-exact": "Only the exact registered asset may be used (no role currently uses this; kept because the closed vocabulary is shared with link roles).",
    "must-not-fabricate": "Real-world evidence (customers). Never invent stand-ins; never reproduce the real ones in generated output.",
    "must-not-reproduce-in-generated-output": "Real brand/proprietary asset. Allowed only in purpose=reference-reconstruction at route \"/\".",
    "must-not-reuse-live-endpoint": "Real live endpoint. Generated pages must use placeholder.generated hrefs instead.",
    "must-not-link-as-existing": "Real route of the live site that is NOT part of this repo. Linking warns; generated pages should not present it as an existing page."
  },
